# Copy to .env for local development. Never commit real secrets.
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Cairo
# Neon: paste the PostgreSQL connection string from Neon Console as a secret.
# Prefer the pooled connection string for web workloads and require SSL.
DATABASE_URL=
